# ═══════════════════════════════════════════════════════════════════
#  Lokal (Mac):  docker compose up -d               (backend+frontend+ntfy)
#  VPS:          docker compose --profile remote up -d   (+ caddy + cloudflared)
# ═══════════════════════════════════════════════════════════════════

# Application
APP_ENV=production
DEBUG=false
TIMEZONE=Europe/Istanbul

# Ports — hepsi 127.0.0.1'e bind'li (compose'da), dışarı açılmaz.
BACKEND_PORT=8000
FRONTEND_PORT=3000
CADDY_PORT=8090
OLLAMA_PORT=11434

# Frontend build-time API adresi. VPS'te panel'e SSH tüneliyle eriştiğin için
# localhost kalabilir; panel'i başka yerden açacaksan tünel hostname'ini yaz.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telegram bot (mesajlaşma kanalı). @BotFather → /newbot → token:
TELEGRAM_BOT_TOKEN=
# Opsiyonel: kaçırılan ilaçta haber verilecek bakıcı chat_id:
ADMIN_CHAT_ID=

# --- Erişim kontrolü — PUBLIC (VPS) deployment'ta MUTLAKA doldur ---
# REGISTRATION_SECRET: boşsa kayıt herkese açık (sadece LAN/dev).
#   Dolu → POST /api/register isteği aynı değeri `invite_code` olarak taşımalı.
#   Aileye bu kodu ver; uygulamada ilk kurulumda bir kez girerler.
REGISTRATION_SECRET=
# ADMIN_TOKEN: boşsa /api/users, /api/admin, /api/dashboard/* auth'suz.
#   Dolu → bu uçlar `X-Admin-Token` header'ı ister (web panel + curl).
#   Caddy ayrıca bu path'leri public tünelde 404'ler; panele SSH tüneliyle gir.
ADMIN_TOKEN=
# Rastgele üret: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# Docker'ın kalıcı veriyi yazdığı yer. VPS'te repo checkout'unun DIŞINDA
# absolute bir yol ver (örn. /opt/med-data) — git workspace'e root-sahipli
# container dosyaları girmesin.
# DATA_ROOT=/opt/med-data

# Cevap gelene kadar push her 10 dk tekrar eder; REMINDER_MAX_RETRIES'inci
# tekrarda bakıcıya (ADMIN_CHAT_ID) bir kez uyarı gider. 'Almadım' durdurmaz.
REMINDER_MAX_RETRIES=3

# --- Push (ntfy → mobil app) ---
PUSH_ENABLED=true
NTFY_PORT=8080
NTFY_TOPIC=medication-reminders
# Lokal: 'read-write' (auth kapalı).  VPS: 'deny-all' + token.
NTFY_AUTH_DEFAULT_ACCESS=deny-all
# deny-all iken: stack'i kaldır, sonra `bash scripts/ntfy-setup.sh` → çıkan tk_...
NTFY_TOKEN=
# ntfy'nin kendini gördüğü public URL (link/att için). Cloudflare hostname + /ntfy:
# NTFY_PUBLIC_URL=https://ilac.alanadi.com/ntfy

# --- Cloudflare Tunnel (sadece --profile remote) ---
# Zero Trust paneli → Networks → Tunnels → Create → token'ı buraya.
# Public hostname → Service: http://caddy:8090  (yine o panelde ayarlanır)
CLOUDFLARE_TUNNEL_TOKEN=

# AI
AI_PROVIDER=openrouter
OLLAMA_MODEL=llama3.2
OPENROUTER_API_KEY=
# ÜCRETSİZ model — sonu ":free" ile bitmeli, asla fatura çıkmaz:
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FREE_ONLY=true

# CORS — mobil app REST'i origin göndermez; panel localhost'ta.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
