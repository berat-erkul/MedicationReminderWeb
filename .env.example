# Application
APP_ENV=production
DEBUG=false
TIMEZONE=Europe/Istanbul

# Ports (home-server host mapping)
BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434
# Reverse proxy (Tailscale Funnel bu portu dışarı açar):
CADDY_PORT=8090

# Frontend → Backend (browser-accessible URL of your home server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telegram bot (mesajlaşma kanalı). @BotFather → /newbot → token:
TELEGRAM_BOT_TOKEN=
# Opsiyonel: kaçırılan ilaçta haber verilecek bakıcı chat_id:
ADMIN_CHAT_ID=

# --- Erişim kontrolü — PUBLIC (VPS) deployment'ta MUTLAKA doldur ---
# REGISTRATION_SECRET: boşsa kayıt herkese açık (sadece LAN/dev).
#   Dolu → POST /api/register isteği aynı değeri `invite_code` olarak taşımalı.
#   Aileye bu kodu ver; uygulamada ilk kurulumda bir kez girerler.
REGISTRATION_SECRET=
# ADMIN_TOKEN: boşsa /api/users, /api/admin, /api/dashboard/* auth'suz.
#   Dolu → bu uçlar `X-Admin-Token` header'ı ister (web panel + curl için).
ADMIN_TOKEN=
# Rastgele üret: python -c "import secrets; print(secrets.token_urlsafe(24))"

# Where Docker stores persistent data. On the CI/CD runner set this to an
# ABSOLUTE path OUTSIDE the repo checkout (örn. /home/berat/med-data) so the
# git workspace never contains root-owned container files.
# DATA_ROOT=/home/berat/med-data

# Reminders: Telegram mesajı butonlarla 1 kere gönderilir; alındı işaretlenene
# kadar push her 5 dakikada bir (koda sabit) REMINDER_MAX_RETRIES kez tekrar
# edilir, sonra 'missed' işaretlenir. 'Almadım' hatırlatmaları durdurmaz.
REMINDER_MAX_RETRIES=3

# Push notifications (ntfy → mobile app). Self-hosted, no API key.
PUSH_ENABLED=true
NTFY_PORT=8080
NTFY_TOPIC=medication-reminders
# Set only if you enable ntfy auth (internet exposure):
# NTFY_TOKEN=

# AI
AI_PROVIDER=openrouter
OLLAMA_MODEL=llama3.2
OPENROUTER_API_KEY=
# ÜCRETSİZ model — sonu ":free" ile bitmeli, asla fatura çıkmaz:
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FREE_ONLY=true

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
